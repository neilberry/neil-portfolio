---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { SITE, NAV_LINKS } from '@/site.config';

import { Image } from 'astro:assets';
import neil from '@/assets/images/neilprofile.jpeg';

const currentPath = Astro.url.pathname;
---

<header class="border-line bg-paper/90 sticky top-0 z-40 border-b backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-4">
        <a href="/" class="font-display text-ink flex items-center gap-3">
      <Image src={neil} alt="" width={64} class="h-10 w-10 rounded-full object-cover" />
      <span class="flex flex-col leading-tight">
        <span class="text-lg font-medium">{SITE.name}</span>
        <span class="text-ink-soft text-xs">Senior Product Designer</span>
      </span>
    </a>

    <nav class="flex items-center gap-5" aria-label="Primary">
      {
        NAV_LINKS.map((link) => {
          const isActive = currentPath === link.href || currentPath.startsWith(`${link.href}/`);
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'font-mono text-xs tracking-wide uppercase transition-colors',
                isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <a
        href="/#contact"
        class="text-ink-soft hover:text-ink hidden font-mono text-xs tracking-wide uppercase transition-colors sm:inline"
      >
        Contact
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
